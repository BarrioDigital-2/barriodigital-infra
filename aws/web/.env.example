# Copiar como .env en esta carpeta (en la EC2 web) y completar. El archivo .env NO se sube a Git.

# Azure AD (mismos IDs que usan requests y el API Gateway)
AZURE_TENANT_ID=92b9ffd8-4da1-4956-b85b-62654b654d25
AZURE_API_CLIENT_ID=8b0cc19f-2671-49c7-beff-816087690691

# IP PRIVADA de la EC2 de apps (donde corre ms-requests en el 8081)
APPS_PRIVATE_IP=172.31.0.0

# IP PÚBLICA (elástica) de ESTA EC2: el front queda en https://<esta IP>
WEB_PUBLIC_IP=0.0.0.0

# URL del API Gateway terminada en /api/v1 (sale en los Outputs del stack de CloudFormation)
API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/api/v1
