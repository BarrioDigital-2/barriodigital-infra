# Copiar como .env en esta carpeta (en la EC2 de apps) y completar. El archivo .env NO se sube a Git.

# MySQL (solo letras, números, - y _)
DB_ROOT_PASSWORD=cambiar-clave-root
DB_PASSWORD=cambiar-clave-app

# Azure AD (los mismos IDs del front y del BFF)
AZURE_TENANT_ID=92b9ffd8-4da1-4956-b85b-62654b654d25
AZURE_API_CLIENT_ID=8b0cc19f-2671-49c7-beff-816087690691

# RabbitMQ: IP PRIVADA de la EC2 de mensajería
RABBITMQ_HOST=172.31.0.0
RABBITMQ_USERNAME=barriodigital
RABBITMQ_PASSWORD=cambiar-clave-rabbit

# Kafka: IP PRIVADA de la EC2 de Kafka, con los 3 brokers
KAFKA_BOOTSTRAP_SERVERS=172.31.0.0:9092,172.31.0.0:9093,172.31.0.0:9094
